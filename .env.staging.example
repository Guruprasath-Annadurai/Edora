# Gate 2 (4.1.0 staging environment) — points a local build at the staging
# Supabase project (edora-staging, ref uldgosisjidydqstabvl) instead of
# production. Copy to .env.staging.local (gitignored) and run with
# `vite --mode staging` or equivalent, once staging's schema is bootstrapped
# (see scripts/bootstrap-staging-db.sh — requires the staging project's DB
# password from https://supabase.com/dashboard/project/uldgosisjidydqstabvl/settings/database,
# a human action, not something this repo can supply).
#
# The anon key below is a public, publishable key by design — same
# sensitivity level as VITE_SUPABASE_ANON_KEY in .env.example, safe to
# commit. It is NOT the service role key and grants no more than RLS
# already allows any anonymous client.
VITE_SUPABASE_URL=https://uldgosisjidydqstabvl.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVsZGdvc2lzamlkeWRxc3RhYnZsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwMjY5NDcsImV4cCI6MjEwMTYwMjk0N30.KSSdgGe_CxxOfqgWil8jNTsjxf-1p-twuwXGkQQo1RQ

# All other secrets (VITE_GOOGLE_CLIENT_ID, RevenueCat/Sentry/PostHog keys)
# still need staging-specific values if you want those integrations to work
# against staging rather than production — left blank here deliberately
# rather than copying production's values across environments.
