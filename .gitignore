node_modules
dist
.env
.env.local
*.local
ios/App/App/public
android/app/src/main/assets/public
.DS_Store
*.log

# Firebase — contains no private keys but best practice to gitignore
android/app/google-services.json
ios/App/App/GoogleService-Info.plist
.vercel

# Android release signing — contains keystore password in plaintext
android/keystore.properties
android/*.jks
android/*.keystore

# TS incremental build cache — machine-specific, regenerated on build
*.tsbuildinfo

# Supabase CLI local link state — records whichever project was last linked
# on this machine (production, staging, ...). Committing it risks silently
# repointing another developer's CLI at the wrong project; each machine
# should link for itself (`supabase link --project-ref ...`).
supabase/.temp/

# gstack skill tool-local state — not project source
.gstack/

# Signed release build artifacts — not source, regenerated per release
release-builds/

# Playwright E2E output — regenerated per run
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Visual-regression baselines are Linux-only by design (see e2e/visual.spec.ts
# and docs/e2e-testing.md) — generated exclusively via the
# generate-visual-baselines.yml workflow on ubuntu-latest, matching CI.
# Ignoring non-linux baselines so a local `--update-snapshots` run on macOS/
# Windows can't accidentally commit a baseline CI will never use.
e2e/**/*-snapshots/*-darwin.png
e2e/**/*-snapshots/*-win32.png
